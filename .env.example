DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_TIME_ZONE=Asia/Kolkata
DATABASE_URL=
DATABASE_SSLMODE=require

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=v2labsofficail@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-gmail-app-password
DEFAULT_FROM_EMAIL=V2 Labs <v2labsofficail@gmail.com>
SERVER_EMAIL=V2 Labs <v2labsofficail@gmail.com>
LEAD_NOTIFICATION_RECIPIENTS=v2labsofficail@gmail.com,vishaldudhabarve105@gmail.com

V2_LABS_COMPANY_NAME=V2 Labs
V2_LABS_FRONTEND_URL=http://localhost:3000

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
